# Copy this file to .env and fill in your values.

# --- Database (docker-compose sets this up for you automatically) ---
DATABASE_URL=postgresql+psycopg2://translator:translator@db:5432/translation_system

# --- Gemini API (required) ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- Auth ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# The first account signed up with this email is automatically made admin.
ADMIN_EMAIL=admin@example.com

# --- Pipeline timeouts (seconds) ---
VALIDATION_TIMEOUT_SECONDS=8
BASE_MODEL_TIMEOUT_SECONDS=8

# --- CORS: where the frontend is served from ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Frontend build-time var (Vite reads this) ---
VITE_API_URL=http://localhost:8000
